<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection exposes Windows.Media.SpeechRecognition,
         the modern speech engine that supports Italian and falls back to the
         on-device models when the online service is unreachable. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- GitHub Actions overrides Version from the release tag (vX.Y.Z). -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <!-- GPU acceleration when a Vulkan driver is present; Whisper.net keeps the
         CPU runtime as automatic fallback, so no machine loses the feature. -->
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ac_bridge\AiRaceEngineer.py" Link="ac_bridge\AiRaceEngineer.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
