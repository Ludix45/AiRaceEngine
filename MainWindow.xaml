<Window x:Class="AiRaceEngineer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Race Engineer" Height="790" Width="1260" MinHeight="670" MinWidth="1020"
        Background="#0D1115" Foreground="#EAF0F3" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Topmost="False">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#171D22" />
        <SolidColorBrush x:Key="Panel2" Color="#20272D" />
        <SolidColorBrush x:Key="Muted" Color="#98A5AE" />
        <SolidColorBrush x:Key="Lime" Color="#A8FF3E" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#273139"/><Setter Property="Foreground" Value="#F4F7F8"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#101519"/><Setter Property="Foreground" Value="#F1F4F6"/><Setter Property="BorderBrush" Value="#35424B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#BCC7CE"/><Setter Property="Padding" Value="18,11"/><Setter Property="Background" Value="#171D22"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7,7,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,5,0"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#283239"/><Setter Property="Foreground" Value="#A8FF3E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="4,0,4,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="42" Height="42" CornerRadius="10" Background="#A8FF3E"><TextBlock Text="AI" Foreground="#101519" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="12,0,0,0"><TextBlock Text="AI RACE ENGINEER" FontSize="18" FontWeight="Bold"/><TextBlock Text="Assistente locale per Assetto Corsa" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="#68747C" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionText" Text="In attesa di Assetto Corsa" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <CheckBox x:Name="AlwaysOnTopCheck" Content="Sempre in primo piano" Foreground="#C5D0D6" VerticalAlignment="Center" Checked="AlwaysOnTopCheck_Changed" Unchecked="AlwaysOnTopCheck_Changed"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="{StaticResource Panel}" BorderThickness="0" Padding="10">
            <TabItem Header="Gara">
                <Grid Margin="8,12,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <UniformGrid Columns="5" Margin="0,0,0,14">
                        <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="15" Margin="0,0,9,0"><StackPanel><TextBlock Text="VELOCITÀ" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="SpeedText" Text="— km/h" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="15" Margin="0,0,9,0"><StackPanel><TextBlock Text="CARBURANTE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="FuelText" Text="— L" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="15" Margin="0,0,9,0"><StackPanel><TextBlock Text="GIRO / POSIZIONE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="LapText" Text="— / —" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="15" Margin="0,0,9,0"><StackPanel><TextBlock Text="GOMME" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="TyreText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/></StackPanel></Border>
                        <Border x:Name="FlagCard" Background="#20272D" CornerRadius="8" Padding="15"><StackPanel><TextBlock Text="BANDIERA AC" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="FlagText" Text="VERDE / NESSUNA" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="9" Padding="15"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Radio e avvisi" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/><ListBox x:Name="EventsList" Background="Transparent" BorderThickness="0" Foreground="#D9E1E5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,5"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
                        <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="9" Padding="17"><StackPanel>
                            <TextBlock Text="INGEGNERE DI GARA" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EngineerStatus" Text="Avvia Assetto Corsa per collegare la telemetria." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,12"/>
                            <TextBlock x:Name="CoachStatus" Text="Coach curva: avvia un giro pulito per imparare frenate e riapertura del gas." Foreground="#A8FF3E" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <Button x:Name="RadioButton" Content="Parla con l’ingegnere" HorizontalAlignment="Stretch" Background="#A8FF3E" Foreground="#101519" Click="RadioButton_Click"/>
                            <TextBlock Text="Dati letti dal gioco: velocità, carburante, giro, gomme, pit lane, penalità e bandiere." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            <Separator Margin="0,15" Background="#35424B"/>
                            <TextBlock Text="Modello locale" FontSize="12" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="ModelStatus" Text="Controllo Ollama…" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel></Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Chat AI">
                <Grid Margin="8,12,8,8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="ChatHistory" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" Background="#11171B"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Height="46" VerticalContentAlignment="Center" KeyDown="ChatInput_KeyDown"/>
                        <Button Grid.Column="1" Content="Invia" Margin="8,0,0,0" Background="#A8FF3E" Foreground="#101519" Click="SendButton_Click"/>
                        <Button Grid.Column="2" Content="Voce on/off" Margin="8,0,0,0" Click="PushToTalkButton_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Report sessione">
                <Grid Margin="8,12,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Report automatico giro per giro" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Ogni giro valido registra tempo, confronto con il riferimento personale, gomme, carburante e chiamate strategiche." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" x:Name="LapReports" Background="#11171B" BorderThickness="0" Foreground="#D9E1E5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#2B363E" BorderThickness="0,0,0,1" Padding="12,10"><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14"/></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Strategia pit">
                <Grid Margin="8,12,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="20" Margin="0,0,10,0"><StackPanel>
                        <TextBlock Text="Stima strategia" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Giri gara previsti" Foreground="{StaticResource Muted}"/><TextBox x:Name="PlannedLapsInput" Text="20" Margin="0,4,0,12"/>
                        <TextBlock Text="Consumo medio (L/giro)" Foreground="{StaticResource Muted}"/><TextBox x:Name="FuelPerLapInput" Text="2.8" Margin="0,4,0,12"/>
                        <TextBlock Text="Usura media gomme (%/giro)" Foreground="{StaticResource Muted}"/><TextBox x:Name="WearPerLapInput" Text="4" Margin="0,4,0,16"/>
                        <Button Content="Calcola" Click="CalculateStrategy_Click" Background="#A8FF3E" Foreground="#101519"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="9" Padding="20"><StackPanel>
                        <TextBlock Text="Consiglio" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="StrategyResult" Text="La stima si aggiorna con i dati della sessione." TextWrapping="Wrap" FontSize="15" Margin="0,12,0,0"/>
                        <TextBlock Text="La stima usa consumo e usura osservati/immessi. La sosta effettiva va confermata nel menu box di Assetto Corsa." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel></Border>
                </Grid>
            </TabItem>
            <TabItem Header="Set-up">
                <Grid Margin="8,12,8,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Consigli di assetto dal modello locale" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBox x:Name="SetupContextInput" Height="75" Text="Scrivi auto, pista, condizioni e comportamento dell’auto (es. sottosterzo in ingresso)." TextWrapping="Wrap" AcceptsReturn="True"/>
                        <Button Grid.Row="1" Content="Analizza assetto" HorizontalAlignment="Left" Margin="0,10,0,10" Click="SetupButton_Click"/>
                        <TextBox Grid.Row="2" x:Name="SetupOutput" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Impostazioni">
                <Grid Margin="8,12,8,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Background="{StaticResource Panel}" CornerRadius="9" Padding="20" Margin="0,0,10,0"><StackPanel>
                        <TextBlock Text="Modello locale Ollama" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Indirizzo API locale" Foreground="{StaticResource Muted}"/><TextBox x:Name="OllamaUrlInput" Text="http://localhost:11434" Margin="0,4,0,12"/>
                        <TextBlock Text="Modello" Foreground="{StaticResource Muted}"/><TextBox x:Name="ModelInput" Text="qwen2.5:3b" Margin="0,4,0,12"/>
                        <TextBlock x:Name="ModelFolderText" Text="Cartella modelli: (lettura variabile OLLAMA_MODELS)" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Salva" Click="SaveSettings_Click"/><Button Content="Verifica Ollama" Margin="8,0,0,0" Click="CheckOllama_Click"/><Button Content="Scarica modello" Margin="8,0,0,0" Click="PullModel_Click" Background="#A8FF3E" Foreground="#101519"/></StackPanel>
                        <TextBlock x:Name="SettingsStatus" Text="Il modello rimane nella cartella configurata in Ollama." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,13,0,0"/>
                        <ProgressBar x:Name="PullProgress" Height="7" Margin="0,9,0,0" Minimum="0" Maximum="100"/>
                    </StackPanel></Border>
                    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="9" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Voce, radio e controller" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Lingua / Language" Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="LanguageCombo" Margin="0,4,0,12" SelectionChanged="Language_Changed">
                            <ComboBoxItem Tag="it">Italiano</ComboBoxItem>
                            <ComboBoxItem Tag="en">English</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Riconoscimento vocale" Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="RecognitionModelCombo" Margin="0,4,0,10" SelectionChanged="RecognitionModel_Changed">
                            <ComboBoxItem Tag="windows">Windows · riconoscimento vocale di sistema</ComboBoxItem>
                            <ComboBoxItem Tag="turbo-q5">Massima accuratezza · Whisper large-v3 turbo · 547 MB</ComboBoxItem>
                            <ComboBoxItem Tag="base">Bilanciato · Whisper base · 142 MB</ComboBoxItem>
                            <ComboBoxItem Tag="tiny">Veloce · Whisper tiny · 77 MB</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Voce dell’ingegnere" Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="OutputVoiceCombo" Margin="0,4,0,10" SelectionChanged="OutputVoice_Changed"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Velocità risposta radio" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="SpeechSpeedText" Grid.Column="1" Foreground="{StaticResource Lime}"/>
                        </Grid>
                        <Slider x:Name="SpeechSpeedSlider" Minimum="75" Maximum="135" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SpeechSpeedSlider_ValueChanged" Margin="0,0,0,9"/>
                        <CheckBox x:Name="NaturalVoiceCheck" Content="Voce neurale italiana locale (più fluida)" Foreground="#EAF0F3" Checked="NaturalVoiceCheck_Changed" Unchecked="NaturalVoiceCheck_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="Prepara voce neurale" Click="PrepareNaturalVoice_Click"/><Button Content="Ascolta prova" Margin="8,0,0,0" Click="TestVoice_Click"/></StackPanel>
                        <TextBlock x:Name="OutputVoiceStatus" Text="Voce italiana di Windows attiva." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <CheckBox x:Name="RaceEngineerCheck" Content="Ingegnere di gara attivo" Foreground="#EAF0F3" Checked="RaceEngineerCheck_Changed" Unchecked="RaceEngineerCheck_Changed" Margin="0,0,0,10"/>
                        <Separator Margin="0,4,0,12" Background="#35424B"/>
                        <TextBlock Text="Coach curva · beep" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="CoachBrakeBeepCheck" Content="Bip per frenata" Foreground="#EAF0F3" Checked="CoachBeeps_Changed" Unchecked="CoachBeeps_Changed" Margin="0,0,0,5"/>
                        <CheckBox x:Name="CoachThrottleBeepCheck" Content="Bip per riapertura gas" Foreground="#EAF0F3" Checked="CoachBeeps_Changed" Unchecked="CoachBeeps_Changed" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Anticipo beep" Foreground="{StaticResource Muted}"/>
                            <TextBlock x:Name="CoachLeadText" Grid.Column="1" Foreground="{StaticResource Lime}"/>
                        </Grid>
                        <Slider x:Name="CoachLeadSlider" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="CoachLeadSlider_ValueChanged" Margin="0,0,0,12"/>
                        <TextBlock Text="Push-to-talk: tieni premuto F8 o il pulsante Menu (tre linee) del controller Xbox. Un bip all’inizio e uno al rilascio confermano il tasto; il riconoscimento usa il microfono predefinito di Windows senza inviare l’audio a un servizio cloud." TextWrapping="Wrap"/>
                        <TextBlock x:Name="VoiceStatus" Text="Riconoscimento vocale italiano: verifica in corso…" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Per visualizzare il pannello sopra AC, usa modalità finestra senza bordi. L’overlay non modifica i banner o le regole del gioco." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel></ScrollViewer></Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
